# Throwaway diagnostic image — not part of the app. Deleted once the Render
# deploy failure is root-caused. Round 3: adds ONLY the apt packages on top
# of the round-2 image that already proved live (USER switch confirmed fine).
# If this one fails the same way, the apt layer (or something it pulls in
# transitively) is the culprit.
FROM python:3.11-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg \
      espeak-ng \
      tesseract-ocr \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN useradd --create-home --uid 1000 preflight && chown -R preflight:preflight /app
USER preflight
CMD ["python3", "-u", "-c", "print('debug boot as', __import__('os').getuid(), flush=True); import http.server; print('binding', flush=True); http.server.HTTPServer(('0.0.0.0', 10000), http.server.SimpleHTTPRequestHandler).serve_forever()"]
