# Throwaway diagnostic image — not part of the app. Deleted once the Render
# deploy failure is root-caused. Round 5: identical to round 4 (proved
# live — real package, real deps, 2.94s import, all fine) except CMD now
# goes through the pip-installed `preflight` console-script via ENTRYPOINT,
# exactly like the production Dockerfile. Every other variable has already
# been cleared; if this one fails, the console-script/ENTRYPOINT invocation
# itself is the confirmed cause.
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg espeak-ng tesseract-ocr ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY preflight/__init__.py preflight/__init__.py
RUN pip install --quiet -e '.[asr,ocr]'
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('base.en', device='cpu', compute_type='int8'); print('base.en cached')"
COPY . .
RUN python scripts/build_corpus.py && python scripts/make_assets.py
RUN useradd --create-home --uid 1000 preflight && chown -R preflight:preflight /app
USER preflight
ENTRYPOINT ["preflight"]
CMD ["serve", "--host", "0.0.0.0", "--port", "10000"]
