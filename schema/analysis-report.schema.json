{
  "$ref": "#/definitions/AnalysisReport",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AdversarialRecord": {
      "additionalProperties": false,
      "properties": {
        "adjudicator": {
          "additionalProperties": false,
          "properties": {
            "confidence": {
              "type": "number"
            },
            "rationale": {
              "type": "string"
            },
            "verdict": {
              "enum": [
                "UPHELD",
                "DISMISSED"
              ],
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "rationale",
            "confidence"
          ],
          "type": "object"
        },
        "advocate": {
          "additionalProperties": false,
          "properties": {
            "defense": {
              "type": [
                "string",
                "null"
              ]
            },
            "strength": {
              "type": "number"
            }
          },
          "required": [
            "defense",
            "strength"
          ],
          "type": "object"
        },
        "auditor": {
          "additionalProperties": false,
          "properties": {
            "charge": {
              "type": "string"
            }
          },
          "required": [
            "charge"
          ],
          "type": "object"
        }
      },
      "required": [
        "auditor",
        "advocate",
        "adjudicator"
      ],
      "type": "object"
    },
    "AgentId": {
      "description": "Keys of the agent identity palette in tailwind.config.ts.",
      "enum": [
        "orchestrator",
        "ingest",
        "speech",
        "vision",
        "ocr",
        "audio",
        "access",
        "meta",
        "policy",
        "score",
        "remedy",
        "report"
      ],
      "type": "string"
    },
    "AgentRun": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "description": "Remote model invocations made by this agent. Free-tier budget evidence.",
          "type": "number"
        },
        "coverage": {
          "description": "0..1 — the fraction of the input this agent actually managed to inspect.",
          "type": "number"
        },
        "detail": {
          "type": "string"
        },
        "elapsedMs": {
          "type": "number"
        },
        "id": {
          "$ref": "#/definitions/AgentId"
        },
        "name": {
          "type": "string"
        },
        "parents": {
          "items": {
            "$ref": "#/definitions/AgentId"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/AgentStatus"
        },
        "tier": {
          "description": "Depth in the DAG. Tier 0 is the orchestrator.",
          "type": "number"
        },
        "tsMs": {
          "description": "Offset from run start, used to sequence the terminal log and graph pulses.",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "tier",
        "parents",
        "status",
        "detail",
        "coverage",
        "elapsedMs",
        "tsMs",
        "calls"
      ],
      "type": "object"
    },
    "AgentStatus": {
      "enum": [
        "OK",
        "DEGRADED",
        "FAILED",
        "SKIPPED",
        "RUNNING",
        "PENDING"
      ],
      "type": "string"
    },
    "AnalysisReport": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/definitions/AgentRun"
          },
          "type": "array"
        },
        "breakdown": {
          "items": {
            "$ref": "#/definitions/BreakdownRow"
          },
          "type": "array"
        },
        "cost": {
          "$ref": "#/definitions/CostRecord"
        },
        "findings": {
          "items": {
            "$ref": "#/definitions/Finding"
          },
          "type": "array"
        },
        "incidents": {
          "items": {
            "$ref": "#/definitions/Incident"
          },
          "type": "array"
        },
        "meta": {
          "$ref": "#/definitions/RunMeta"
        },
        "reasoning": {
          "items": {
            "$ref": "#/definitions/ReasoningChain"
          },
          "type": "array"
        },
        "remediation": {
          "$ref": "#/definitions/Remediation"
        },
        "riskBands": {
          "items": {
            "$ref": "#/definitions/RiskBand"
          },
          "type": "array"
        },
        "scores": {
          "$ref": "#/definitions/Scores"
        },
        "segments": {
          "description": "Present only for videos long enough to roll up (see the decomposition plan's threshold). Absent, not empty, on short videos — an empty array would read as \"rolled up and found nothing\".",
          "items": {
            "$ref": "#/definitions/Segment"
          },
          "type": "array"
        },
        "simulation": {
          "$ref": "#/definitions/Simulation"
        },
        "video": {
          "$ref": "#/definitions/VideoMeta"
        }
      },
      "required": [
        "video",
        "meta",
        "scores",
        "riskBands",
        "findings",
        "incidents",
        "reasoning",
        "simulation",
        "breakdown",
        "remediation",
        "agents",
        "cost"
      ],
      "type": "object"
    },
    "BreakdownRow": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string"
        },
        "count": {
          "type": "number"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        }
      },
      "required": [
        "category",
        "count",
        "severity"
      ],
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One sentence of reasoning, and the thing it cites.\n\nA claim cannot exist without a source — that is enforced where these are constructed, so \"never invent evidence\" is a property of the shape rather than a rule someone has to remember.",
      "properties": {
        "source": {
          "$ref": "#/definitions/ClaimSource"
        },
        "step": {
          "enum": [
            "observation",
            "evidence",
            "policy",
            "risk_argument",
            "counter_argument",
            "decision",
            "uncertainty"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "step",
        "text",
        "source"
      ],
      "type": "object"
    },
    "ClaimSource": {
      "additionalProperties": false,
      "description": "What entitles a claim to be made. Every claim carries one.",
      "properties": {
        "detail": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "finding",
            "clause",
            "agent",
            "measurement"
          ],
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "detail"
      ],
      "type": "object"
    },
    "CostRecord": {
      "additionalProperties": false,
      "description": "What the run predicted it would cost, against what it actually spent.\n\n`estimatedCalls` comes from the decomposition plan, computed before any work started, and is an upper bound by construction — so `actualCalls` exceeding it means the plan is wrong, not merely pessimistic. That makes this block a check on PREFLIGHT rather than a decoration.",
      "properties": {
        "actualCalls": {
          "type": "number"
        },
        "ceiling": {
          "description": "Ceiling in force, or null when the run was uncapped.",
          "type": [
            "number",
            "null"
          ]
        },
        "estimatedCalls": {
          "type": "number"
        },
        "shed": {
          "items": {
            "$ref": "#/definitions/ShedRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "estimatedCalls",
        "actualCalls",
        "ceiling",
        "shed"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "adversarial": {
          "$ref": "#/definitions/AdversarialRecord"
        },
        "category": {
          "type": "string"
        },
        "clauseId": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "description": {
          "type": "string"
        },
        "endMs": {
          "type": "number"
        },
        "evidence": {
          "additionalProperties": false,
          "properties": {
            "frames": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "highlightSpan": {
              "description": "[start, end] character offsets into `transcript`.",
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "transcript": {
              "type": "string"
            }
          },
          "required": [
            "transcript",
            "highlightSpan",
            "frames"
          ],
          "type": "object"
        },
        "fusedConfidence": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "modalities": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Per-modality confidence before fusion, e.g. { speech: 0.94, vision: 0.92 }.",
          "type": "object"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "clauseId": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "clauseId",
            "title",
            "section",
            "text"
          ],
          "type": "object"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "startMs": {
          "type": "number"
        },
        "suggestedFix": {
          "anyOf": [
            {
              "$ref": "#/definitions/OpKind"
            },
            {
              "const": "NONE",
              "type": "string"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "clauseId",
        "category",
        "title",
        "description",
        "startMs",
        "endMs",
        "severity",
        "confidence",
        "modalities",
        "fusedConfidence",
        "evidence",
        "policy",
        "adversarial",
        "suggestedFix"
      ],
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "description": "One event, as every agent that saw it described it.\n\nFindings are what each agent reported; incidents are what happened. Four agents noticing the same moment is one problem observed four times, and a creator deciding what to fix needs the second view — the first tells them how many detectors fired, which is a fact about PREFLIGHT rather than about their video.",
      "properties": {
        "agents": {
          "description": "Independent agents that observed this. One agent reporting twice does not appear twice, because an observer repeating itself is not corroboration.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "type": "string"
        },
        "clauses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "description": "0..1 — the best single observation, plus a bounded corroboration step per additional independent agent. Never reaches certainty.",
          "type": "number"
        },
        "corroborated": {
          "description": "True when more than one independent agent saw it.",
          "type": "boolean"
        },
        "endMs": {
          "type": "number"
        },
        "findingIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "startMs": {
          "type": "number"
        },
        "suggestedFix": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "startMs",
        "endMs",
        "category",
        "severity",
        "confidence",
        "findingIds",
        "agents",
        "clauses",
        "suggestedFix",
        "reasoning",
        "corroborated"
      ],
      "type": "object"
    },
    "OpKind": {
      "enum": [
        "MUTE",
        "BLEEP",
        "BLUR_REGION",
        "REPLACE_AUDIO",
        "CUT"
      ],
      "type": "string"
    },
    "ReasoningChain": {
      "additionalProperties": false,
      "description": "Why one incident was concluded, in reading order.\n\n`unresolved` is the section a reviewer reads first: what would have changed this, which agents never looked, and where the confidence is thin. `dismissed` answers the second question — which charges were considered and rejected, and on what grounds.",
      "properties": {
        "agentsCited": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/definitions/Claim"
          },
          "type": "array"
        },
        "clausesCited": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "type": "number"
        },
        "decision": {
          "type": "string"
        },
        "dismissed": {
          "items": {
            "$ref": "#/definitions/Claim"
          },
          "type": "array"
        },
        "incidentId": {
          "type": "string"
        },
        "unresolved": {
          "items": {
            "$ref": "#/definitions/Claim"
          },
          "type": "array"
        }
      },
      "required": [
        "incidentId",
        "decision",
        "confidence",
        "claims",
        "dismissed",
        "unresolved",
        "agentsCited",
        "clausesCited"
      ],
      "type": "object"
    },
    "Remediation": {
      "additionalProperties": false,
      "properties": {
        "ffmpegCommand": {
          "type": "string"
        },
        "log": {
          "description": "Human-readable compiler decisions, in order — snap-to-word, coalesce, cut-budget demotions, and (when a strategy is set) \"chose BLEEP over CUT — same risk reduction, 0.65 less viewer impact\" style overrides.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ops": {
          "items": {
            "$ref": "#/definitions/RemediationOp"
          },
          "type": "array"
        },
        "renderMs": {
          "type": "number"
        },
        "strategy": {
          "description": "Strategy applied, if any — conservative|balanced|aggressive. Absent means each finding's own suggested fix was trusted directly.",
          "type": "string"
        },
        "videoStreamCopied": {
          "type": "boolean"
        }
      },
      "required": [
        "ops",
        "ffmpegCommand",
        "renderMs",
        "videoStreamCopied",
        "log"
      ],
      "type": "object"
    },
    "RemediationOp": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "description": "REPLACE_AUDIO only — path to the CC-licensed replacement bed.",
          "type": "string"
        },
        "box": {
          "description": "BLUR_REGION only — normalised [x, y, w, h] in the 0..1 frame space.",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "details": {
          "type": "string"
        },
        "endMs": {
          "type": "number"
        },
        "findingId": {
          "type": "string"
        },
        "freqHz": {
          "description": "BLEEP only — tone frequency in Hz.",
          "type": "number"
        },
        "index": {
          "type": "number"
        },
        "op": {
          "$ref": "#/definitions/OpKind"
        },
        "startMs": {
          "type": "number"
        }
      },
      "required": [
        "index",
        "op",
        "startMs",
        "endMs",
        "details",
        "findingId"
      ],
      "type": "object"
    },
    "RiskBand": {
      "additionalProperties": false,
      "properties": {
        "endMs": {
          "type": "number"
        },
        "risk": {
          "description": "0..1",
          "type": "number"
        },
        "startMs": {
          "type": "number"
        }
      },
      "required": [
        "startMs",
        "endMs",
        "risk"
      ],
      "type": "object"
    },
    "RunMeta": {
      "additionalProperties": false,
      "properties": {
        "analyzedAt": {
          "type": "string"
        },
        "attestationHash": {
          "type": "string"
        },
        "coverage": {
          "description": "0..1 — weighted mean of per-agent coverage. Reported, never hidden.",
          "type": "number"
        },
        "engineVersion": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        }
      },
      "required": [
        "analyzedAt",
        "policyVersion",
        "engineVersion",
        "attestationHash",
        "coverage"
      ],
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "description": "One hypothetical version of the video, scored by the real scorer.\n\n`impact` is viewer cost on the remediation compiler's own scale, and `value` is score gained per unit of it. Ranking on `overall` alone recommends the most destructive edit available, which scores best precisely because it removes the most.",
      "properties": {
        "delta": {
          "type": "number"
        },
        "edits": {
          "items": {
            "$ref": "#/definitions/SimEdit"
          },
          "type": "array"
        },
        "gatedBy": {
          "description": "Set when an edit repaired something real but the clamp held the score at a different, weaker dimension — \"+0\" without this reads as \"worthless\", which is the opposite of the truth.",
          "type": [
            "string",
            "null"
          ]
        },
        "impact": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "overall": {
          "type": "number"
        },
        "removedFindingIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sub": {
          "$ref": "#/definitions/SubScores"
        },
        "survivingFindings": {
          "type": "number"
        },
        "value": {
          "type": "number"
        },
        "verdict": {
          "$ref": "#/definitions/Verdict"
        },
        "weakenedFindingIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "edits",
        "overall",
        "verdict",
        "sub",
        "delta",
        "impact",
        "value",
        "gatedBy",
        "survivingFindings",
        "removedFindingIds",
        "weakenedFindingIds"
      ],
      "type": "object"
    },
    "Scores": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "type": "number"
        },
        "sub": {
          "$ref": "#/definitions/SubScores"
        },
        "verdict": {
          "$ref": "#/definitions/Verdict"
        },
        "weakest": {
          "$ref": "#/definitions/SubScoreKey"
        }
      },
      "required": [
        "overall",
        "sub",
        "verdict",
        "weakest"
      ],
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "One fixed-length slice of a long video, ranked by how much of the total risk it carries. A 90-minute upload with 200 findings is not usefully read as a list of 200 findings; it is usefully read as \"segments 4 and 7 carry 82% of the risk\". Emitted only above the rollup threshold — short videos are their own segment and the grouping tells you nothing.",
      "properties": {
        "dominantClause": {
          "description": "Most frequent clause in this segment, or null when it is clean.",
          "type": [
            "string",
            "null"
          ]
        },
        "endMs": {
          "type": "number"
        },
        "findingCount": {
          "type": "number"
        },
        "index": {
          "type": "number"
        },
        "riskShare": {
          "description": "0..1 — share of the run's total risk sitting in this segment.",
          "type": "number"
        },
        "startMs": {
          "type": "number"
        },
        "worstSeverity": {
          "anyOf": [
            {
              "$ref": "#/definitions/Severity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index",
        "startMs",
        "endMs",
        "findingCount",
        "riskShare",
        "dominantClause",
        "worstSeverity"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "The PREFLIGHT data contract.\n\nEvery value rendered on the Command Deck derives from this shape. When the Python engine replaces the fixture with a real response, nothing in `src/components` should need to change.",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "type": "string"
    },
    "ShedRecord": {
      "additionalProperties": false,
      "description": "One stage the run gave up to stay inside its call budget.",
      "properties": {
        "reason": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "windowsLost": {
          "description": "Windows the AUDITOR never examined because of this shed.",
          "type": "number"
        }
      },
      "required": [
        "stage",
        "reason",
        "windowsLost"
      ],
      "type": "object"
    },
    "SimEdit": {
      "additionalProperties": false,
      "description": "One change a creator could make, and what it destroys.",
      "properties": {
        "endMs": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "removes": {
          "description": "Modalities this edit removes — the physical claim the simulation rests on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "startMs": {
          "type": "number"
        },
        "wholeFile": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "startMs",
        "endMs",
        "label",
        "wholeFile",
        "removes"
      ],
      "type": "object"
    },
    "Simulation": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/definitions/Scenario"
        },
        "best": {
          "description": "Most worth making, among edits the compiler would actually render.",
          "type": "string"
        },
        "highestScore": {
          "description": "Highest achievable score, whatever it costs the video.",
          "type": "string"
        },
        "scenarios": {
          "items": {
            "$ref": "#/definitions/Scenario"
          },
          "type": "array"
        }
      },
      "required": [
        "baseline",
        "scenarios",
        "best",
        "highestScore"
      ],
      "type": "object"
    },
    "SubScoreKey": {
      "enum": [
        "policy",
        "copyright",
        "metadata",
        "accessibility",
        "audio"
      ],
      "type": "string"
    },
    "SubScores": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "type": "number"
        },
        "audio": {
          "type": "number"
        },
        "copyright": {
          "type": "number"
        },
        "metadata": {
          "type": "number"
        },
        "policy": {
          "type": "number"
        }
      },
      "required": [
        "policy",
        "copyright",
        "metadata",
        "accessibility",
        "audio"
      ],
      "type": "object"
    },
