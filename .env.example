# Copy to .env and fill in. Never commit .env.
#
# PREFLIGHT runs with NONE of these set. The default path uses local models and
# touches no network; keys upgrade individual layers rather than enabling them.

# Free tier, no credit card: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional — acoustic fingerprint lookup: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# Requests per minute. The community free tier baseline is around 40; 30 leaves
# headroom so a burst never trips a 429 mid-demo.
PREFLIGHT_RPM=30

# 1 = never touch the network, even if a key is present.
PREFLIGHT_OFFLINE=0

PREFLIGHT_CACHE_DIR=.preflight/cache
